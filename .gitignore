# Environment. The glob matters: a plain `.env` rule does not cover .env.backup,
# .env.local, .env.sepolia and friends, and `git add -A` will happily commit those.
.env*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Hardhat (all generated by `npm run compile`)
node_modules/
cache/
artifacts/
typechain-types/
types/ethers-contracts/

# Pipeline outputs (keep directory via .gitkeep)
data/outputs/*
!data/outputs/.gitkeep
# Faces of real people are committed nowhere in this repository: a clone starts with no
# tiles and the UI says so. A face published to a public repo cannot be retracted, and it
# is not ours to publish. Drop your own images in and they become one-click demos.
data/samples/*
!data/samples/.gitkeep

# Sensitive/generated evidence and model caches.
# The leading slash matters: a bare `evidence/` matches a directory of that name at ANY
# depth, so it silently swallowed sigil/evidence/, the canonicalization, Merkle and bundle
# source. The published repo could not import. Anchor these to the repository root.
/evidence/
/models/
*.embedding.json
*.wallet.json

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log

# Sigil generated artifacts
data/bundles/
*.onnx
scikit_learn_data/

# Vercel
.vercel/
public/
