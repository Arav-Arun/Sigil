# SerpApi, the reverse-image and web search provider. https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# Exa, an optional second discovery source. https://exa.ai/
# Without it the pipeline runs on SerpApi, Wikidata and page harvesting alone.
EXA_API_KEY=

# Sepolia RPC. Must be a Sepolia endpoint (chain 11155111), not mainnet.
# A public endpoint works for verification: https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_api_key

# A throwaway, faucet-funded wallet. Never a wallet holding anything of value.
# Only anchoring needs this. Verification is read-only and needs no key at all.
PRIVATE_KEY=your_wallet_private_key_without_0x_prefix

# Set after `npm run deploy:sepolia`, or leave blank to read it from a bundle receipt.
CONTRACT_ADDRESS=
